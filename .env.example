# ─── Banco de Dados ───────────────────────────────────────────────────────────

# Opção 1 — SQLite (padrão, sem configuração extra)
# Os dados ficam salvos no diretório DATA_DIR abaixo.
DATA_DIR=/data

# Opção 2 — PostgreSQL (comentar DATA_DIR e descomentar DATABASE_URL)
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# ─── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
